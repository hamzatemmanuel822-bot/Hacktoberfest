# GEMINI_API_KEY: Required for Gemini / Gemma 4 AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port configuration (default 3000)
PORT=3000

# Arduino UNO Q Device Gateway & Authentication
SMARTWELCOME_GATEWAY_URL="ws://localhost:3000/ws/device"
UNO_Q_AUTH_TOKEN="uno-q-sec-9812-token-auth"
UNO_Q_DEVICE_ID="UNO-Q-ENTRANCE-01"

# Local Gemma 4 Inference (Ollama / vLLM runtime)
GEMMA_INFERENCE_ENDPOINT="http://localhost:11434"
GEMMA_MODEL_VARIANT="gemma-4-e2b"
